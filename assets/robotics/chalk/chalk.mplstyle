# Blackboard chalk style for the site's matplotlib figures.
# Colors match the RL series boards (assets/robotics/rl/series.css, --bb-*).
# Use it through chalk.py (chalk.use()), which also registers the Patrick Hand
# font and applies the chalk grain on save. See README.md.
# Lines are straight and text sits on a straight baseline, as on the RL boards:
# no path.sketch and no xkcd mode.

# Board and chalk
figure.facecolor: 1d2824
figure.edgecolor: 1d2824
savefig.facecolor: 1d2824
savefig.edgecolor: 1d2824
axes.facecolor: 1d2824
text.color: f4f1e8
axes.labelcolor: f4f1e8
axes.titlecolor: ffe17c
axes.edgecolor: c3c9bd
xtick.color: c3c9bd
ytick.color: c3c9bd
xtick.labelcolor: c3c9bd
ytick.labelcolor: c3c9bd
grid.color: 6f7d75
grid.alpha: 0.55
grid.linewidth: 1.0
grid.linestyle: --
legend.labelcolor: f4f1e8
legend.frameon: False
axes.prop_cycle: cycler('color', ['93d4ff', 'ff9f88', 'a8e2a0', 'ffe17c', 'ff93b8', 'c9b6ff', 'c3c9bd'])

# Hand lettering. Glyphs that Patrick Hand lacks (Greek, arrows) fall back to DejaVu Sans.
# DejaVu math writes real Unicode in vector panels; the STIX fallback writes some
# Greek letters as private-use glyphs that phones without STIX cannot render.
font.family: Patrick Hand, DejaVu Sans
mathtext.fontset: dejavusans
axes.unicode_minus: True
axes.titleweight: normal
figure.titleweight: normal
axes.titlelocation: left

# Phone sizes. The article column is about 358 px wide on a 390 px phone.
# A 6.4 in figure at these sizes gives 10.5 px tick labels and 11.6 px body text.
figure.figsize: 6.4, 4.2
figure.dpi: 100
savefig.dpi: 220
font.size: 15
axes.titlesize: 17.5
figure.titlesize: 19
axes.labelsize: 15
xtick.labelsize: 14
ytick.labelsize: 14
legend.fontsize: 14
legend.title_fontsize: 14

# Chalk strokes: thicker lines, no top and right frame.
lines.linewidth: 2.6
lines.markersize: 7
patch.linewidth: 1.6
hatch.color: c3c9bd
axes.linewidth: 1.7
axes.spines.top: False
axes.spines.right: False
axes.grid: False
axes.axisbelow: True
xtick.major.width: 1.5
ytick.major.width: 1.5
xtick.major.size: 5
ytick.major.size: 5
xtick.minor.width: 1.1
ytick.minor.width: 1.1

# Vector panels for the long-form canvas (chalk.save(..., panel=True)): the text stays
# text, so the page draws it in its own hand font on a straight baseline.
svg.fonttype: none
svg.hashsalt: chalk
